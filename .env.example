# Leave empty to use persistent local PostgreSQL (.data/goshop).
# Copy the full connection string from Neon > Connect, retaining SSL parameters.
DATABASE_URL=
PORT=3001
APP_ORIGIN=http://localhost:5173
# Set to production when deploying; requires DATABASE_URL and HTTPS.
NODE_ENV=development
# Development only. Never seed demonstration accounts into a real store.
SEED_DEMO=true
DEMO_PASSWORD=GoShopDemo!2026
# Set privately only when bootstrapping a production administrator.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
